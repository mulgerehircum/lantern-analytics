# --- AWS (DynamoDB rollups) ---
# Scoped read-only IAM user credentials for the lantern-events table.
# Non-standard names because Vercel Functions run on Lambda, which reserves
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY for its own runtime — see src/lib/dynamodb.ts.
LANTERN_AWS_REGION=eu-central-1
LANTERN_AWS_ACCESS_KEY_ID=replace-with-scoped-key-id
LANTERN_AWS_SECRET_ACCESS_KEY=replace-with-scoped-secret
EVENTS_TABLE_NAME=lantern-events

# --- Session recordings (Phase 2) ---
RECORDING_RECEIVER_URL=https://replace-with-tunnel-hostname
RECORDING_READ_TOKEN=replace-with-a-long-random-value

# --- AI query interface (Phase 3) ---
# Free from Google AI Studio (https://aistudio.google.com/apikey) — the
# Gemini Developer API free tier needs no billing account attached.
# Server-side only; see src/lib/ai-query.ts and src/app/api/ai-query/route.ts.
GEMINI_API_KEY=replace-with-your-gemini-api-key
