PORT=4000
DATA_DIR=./data

# Public: shipped inside the tracker's public tracker-recorder.js chunk so the
# browser can POST directly to this service. NOT a secrecy boundary — anyone
# can view-source it. Its only job is to stop anonymous scanners from hitting
# the tunnel hostname with zero credential at all. See README.md's "Auth" section.
WRITE_TOKEN=replace-with-a-long-random-value

# Private: configured only as a Vercel server-side env var
# (RECORDING_READ_TOKEN) on the dashboard, never sent to any browser. This is
# where the real security value lives.
READ_TOKEN=replace-with-a-different-long-random-value
